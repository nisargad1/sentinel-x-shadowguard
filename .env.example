# SENTINEL-X ShadowGuard Environment Configuration Template
# Duplicate this file to .env and configure secrets

# Core Environment
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# Cryptographic Gateway Key (Rotate regularly in production)
HMAC_SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-32-bytes

# Allowed HMAC clock drift in seconds (Default: 300 = 5 minutes)
HMAC_MAX_DRIFT_SECONDS=300

# Gateway Enforcement Thresholds
INTENT_DRIFT_THRESHOLD=0.65
RISK_SCORE_THRESHOLD=60
HONEYPOT_ENABLED=true

# Database (SQLite by default, or PostgreSQL for persistent production)
# SQLite: sqlite:///./shadowguard.db
# PostgreSQL: postgresql://user:password@hostname:5432/shadowguard
DATABASE_URL=sqlite:///./shadowguard.db

# Admin Token for Demo Telemetry Reset
DEMO_RESET_TOKEN=replace-with-secure-admin-token-for-resets

# Optional LLM Provider Key (Gateway falls back deterministically if omitted)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
